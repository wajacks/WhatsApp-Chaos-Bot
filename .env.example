# Required by the current Azure OpenAI client initialization.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# Azure image deployment used by !draw. Set this to match your Azure deployment.
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
# Optional image API response timeout in milliseconds (defaults to 300000 / 5 minutes).
AZURE_OPENAI_IMAGE_TIMEOUT_MS=300000

# Owner-only commands. Use the WhatsApp number with country code, digits only.
OWNER_NUMBER=
# Optional additional Class Portal application approvers (comma-separated international numbers).
# OWNER_NUMBER is always included. New applications expire after 14 days.
CLASS_APPROVER_NUMBERS=

# Optional voice-note AI. Set true after configuring the Azure Speech credentials below.
# Direct messages are handled automatically; in groups, reply to or mention the bot.
AI_VOICE_NOTES_ENABLED=false
# Automatically send short AI chat replies as voice notes. Set false to keep them as text unless requested.
AI_VOICE_AUTO_SHORT_REPLIES=true
# Allow occasional casual AI replies to use two messages: a text follow-up or a voice-note continuation.
AI_MULTI_MESSAGE_REPLIES_ENABLED=true
# Minimum minutes between two-part replies per sender; default 10. Owner bypasses this cooldown; 0 disables it.
AI_MULTI_MESSAGE_COOLDOWN_MINUTES=10
AZURE_SPEECH_KEY=
# You may set the resource endpoint, or set the region and let the bot build the endpoint.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_REGION=italynorth
# Comma-separated Azure Speech locale candidates for language identification (first 10 are used).
# Default: English/Kiswahili (Kenya), Arabic (Egypt), Afrikaans, isiZulu, Somali, and Amharic.
# Swap en-KE for en-NG or en-ZA if that English locale best fits the group.
AZURE_SPEECH_LOCALES=en-KE,sw-KE,ar-EG,af-ZA,zu-ZA,so-SO,am-ET
AI_VOICE_MAX_AUDIO_MB=20
AI_VOICE_TRANSCRIBE_TIMEOUT_MS=60000
# Azure Neural TTS is used only if Edge TTS fails; set false to avoid this fallback and its usage charges.
AI_VOICE_AZURE_TTS_FALLBACK=true
AI_VOICE_REPLY_MAX_CHARS=2500

# Ordinary AI usage fairness. Safe bot-feature and Class Portal requests do not count toward these caps.
# The owner bypasses these usage caps; extraction protections and one in-flight AI request still apply.
AI_PROMPTS_PER_MINUTE=12
AI_PROMPTS_PER_HOUR=100
# Escalating responses for repeated prompt bursts; durations are seconds (default 40s, 3m, warning, 1h).
# Use 0 for a warning-only step.
AI_OVERUSE_BAN_STEPS_SECONDS=40,180,0,3600
AI_OVERUSE_STRIKE_WINDOW_DAYS=7
AI_OVERUSE_STRIKE_DECAY_HOURS=24

# Optional integrations.
# Optional fallback for ordinary AI chat only, plus Mafia narration, Number Run, and Truth Hunt.
# Live AI web research uses Azure OpenAI Responses API web_search (Grounding with Bing), not Gemini.
GEMINI_API_KEY=
# Gemini model used for text fallback; defaults to Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash
# Azure web research uses Grounding with Bing and can incur search usage charges.
# It sends the search query outside Azure's normal compliance and geo boundary. Per non-owner sender daily limit while this process runs (default 20; 0 disables); the verified owner bypasses this cap.
AI_WEB_RESEARCH_DAILY_LIMIT=20
OPENWEATHERMAP_API_KEY=

# Optional: encrypted off-site backups for Class Portal data (Azure Blob Storage).
# Use a private blob container HTTPS SAS URL with read, create, and write permissions.
# Generate the 32-byte AES-256 key with: openssl rand -base64 32
AZURE_CLASS_BACKUP_CONTAINER_SAS_URL=
CLASS_BACKUP_ENCRYPTION_KEY=

# Optional: set a WhatsApp number to request a pairing code instead of using a QR.
# Leave blank to use the QR code.
PAIRING_NUMBER=
